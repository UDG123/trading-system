PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_system
REDIS_URL=redis://localhost:6379/0

# Signal source: internal engine is primary; TradingView is optional/off by default.
SIGNAL_SOURCE=INTERNAL_ENGINE
ENABLE_TRADINGVIEW_WEBHOOK=false
WEBHOOK_SECRET=

# Data providers. Missing TWELVEDATA_API_KEY falls back to mock provider.
LIVE_DATA_ENABLED=true
DATA_PROVIDER=TWELVEDATA
TWELVEDATA_API_KEY=
POLYGON_API_KEY=

# Railway worker switches.
WORKER_SCANNER_ENABLED=true
WORKER_PIPELINE_ENABLED=true
WORKER_EXECUTION_ENABLED=true
INTERNAL_SCANNER_INTERVAL_SECONDS=60
INTERNAL_SCANNER_MAX_SYMBOLS_PER_CYCLE=50

# Safety: paper/shadow simulation only by default.
LIVE_TRADING_ENABLED=false
MCP_EXECUTION_ENABLED=false
ACCOUNT_EQUITY=100000
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=3
MAX_OPEN_TRADES=3
MAX_TRADES_PER_DAY=10
MIN_RR=1.5
ENABLE_CRYPTO_DESK=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
